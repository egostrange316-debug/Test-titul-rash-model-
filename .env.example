# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE_URL: Supabase loyihangizning REST API manzili.
# Masalan: https://xxxxxxxxxxxx.supabase.co
# Supabase Dashboard -> Project Settings -> API bo'limidan oling.
SUPABASE_URL=MY_SUPABASE_URL

# SUPABASE_ANON_KEY: Supabase loyihangizning anon/public API kaliti.
# Supabase Dashboard -> Project Settings -> API -> "anon public" bo'limidan oling.
# DIQQAT: bu yerga hech qachon "service_role" kalitini qo'ymang (u faqat backend uchun).
SUPABASE_ANON_KEY=MY_SUPABASE_ANON_KEY

